{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mahitech580.github.io/CYRUS-Autonomous-Agentic-Intelligence-System/schemas/browser-demo-archive-v1.schema.json",
  "title": "CYRUS Browser Demo Archive v1",
  "description": "A sanitized, browser-local archive of synthetic execution reports. Import never resumes an execution or changes backend history.",
  "type": "object",
  "required": ["format", "schema_version", "runtime", "persistence", "task_count", "tasks"],
  "properties": {
    "format": { "const": "CYRUS_BROWSER_DEMO_ARCHIVE" },
    "schema_version": { "const": 1 },
    "exported_at": { "type": "string", "format": "date-time" },
    "runtime": { "const": "browser-demo" },
    "persistence": { "const": "browser-local-only" },
    "task_count": { "type": "integer", "minimum": 0, "maximum": 25 },
    "tasks": {
      "type": "array",
      "maxItems": 25,
      "items": { "$ref": "#/$defs/executionReport" }
    },
    "notice": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": {
    "executionReport": {
      "type": "object",
      "required": ["format", "schema_version", "task"],
      "properties": {
        "format": { "const": "CYRUS_EXECUTION_REPORT" },
        "schema_version": { "const": 1 },
        "exported_at": { "type": "string", "format": "date-time" },
        "notice": { "type": "string" },
        "sensitive_text_warnings": { "type": "array", "items": { "type": "object" } },
        "task": {
          "type": "object",
          "required": ["task_id", "status"],
          "properties": {
            "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" },
            "status": {
              "enum": ["QUEUED", "RUNNING", "AWAITING_APPROVAL", "COMPLETED", "FAILED", "CANCELLED", "TIMED_OUT"]
            },
            "mode": { "enum": ["autonomous", "supervised"] },
            "parent_task_id": { "type": ["string", "null"] },
            "retry_number": { "type": "integer", "minimum": 0 },
            "retry_reason": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
