# Copy to .env for local use. Never commit real values.
# OpenAI Responses API provider. Each full workflow uses seven model calls.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CYRUS_MODEL=gpt-6-luna
CYRUS_MAX_OUTPUT_TOKENS=1200
CYRUS_LLM_TIMEOUT_SECONDS=35
CYRUS_PROVIDER_RETRIES=2
CYRUS_ENABLE_WEB_SEARCH=false

# Set a random access key for publicly deployed workspaces.
# Configure it as CYRUS_ACCESS_KEY on the backend and enter the same value in Settings.
CYRUS_ACCESS_KEY=

# Local Docker Compose PostgreSQL password only; replace before sharing the host.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# SQLite works locally. Production must use managed PostgreSQL/MySQL.
DATABASE_URL=sqlite:///./cyrus.db
# PostgreSQL: postgresql+psycopg://user:password@host:5432/cyrus
# MySQL: mysql+pymysql://user:password@host:3306/cyrus

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000

# Set true on the API when a separately supervised worker consumes the database queue.
# Vercel automatically requires an external worker even if this is unset.
CYRUS_EXTERNAL_WORKER=false
CYRUS_WORKER_ID=
CYRUS_WORKER_POLL_SECONDS=2
CYRUS_WORKER_HEARTBEAT_SECONDS=15
CYRUS_WORKER_HEARTBEAT_TTL_SECONDS=90
CYRUS_WORKER_RECOVERY_SECONDS=30
CYRUS_WORKER_STALE_SECONDS=600
